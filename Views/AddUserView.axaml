<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ktpt.CourseOrder.Views.AddUserView">

	<ScrollViewer>
		<StackPanel Spacing="20" MaxWidth="820" HorizontalAlignment="Stretch" Margin="0,0,0,20">
			<StackPanel Spacing="4">
				<TextBlock Classes="h1" Text="Добавление читателя" />
				<TextBlock Classes="muted" Text="Новый читатель сможет войти в систему со своим паролем" />
			</StackPanel>

			<Border Classes="card" Padding="28">
				<StackPanel Spacing="16">
					<Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
						<TextBlock Classes="label" Text="ФАМИЛИЯ *" Margin="0,0,0,6" />
						<TextBlock Grid.Column="1" Classes="label" Text="ИМЯ *" Margin="12,0,0,6" />
						<TextBlock Grid.Column="2" Classes="label" Text="ОТЧЕСТВО" Margin="12,0,0,6" />
						<TextBox Grid.Row="1" x:Name="LastNameBox" PlaceholderText="Иванов" />
						<TextBox Grid.Row="1" Grid.Column="1" x:Name="FirstNameBox" PlaceholderText="Иван" Margin="12,0,0,0" />
						<TextBox Grid.Row="1" Grid.Column="2" x:Name="MiddleNameBox" PlaceholderText="Иванович" Margin="12,0,0,0" />
					</Grid>

					<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
						<TextBlock Classes="label" Text="EMAIL *" Margin="0,0,0,6" />
						<TextBlock Grid.Column="1" Classes="label" Text="ТЕЛЕФОН" Margin="12,0,0,6" />
						<TextBox Grid.Row="1" x:Name="EmailBox" PlaceholderText="example@mail.ru" />
						<TextBox Grid.Row="1" Grid.Column="1" x:Name="PhoneBox" PlaceholderText="+7-999-000-00-00" Margin="12,0,0,0" />
					</Grid>

					<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
						<TextBlock Classes="label" Text="ГРУППА" Margin="0,0,0,6" />
						<TextBlock Grid.Column="1" Classes="label" Text="ПАРОЛЬ ДЛЯ ВХОДА *" Margin="12,0,0,6" />
						<TextBox Grid.Row="1" x:Name="GroupBox" PlaceholderText="ИС-21" />
						<TextBox Grid.Row="1" Grid.Column="1" x:Name="PasswordBox" PlaceholderText="Не короче 4 символов"
						         PasswordChar="●" Margin="12,0,0,0" />
					</Grid>

					<Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4" />

					<StackPanel Orientation="Horizontal" Spacing="10">
						<Button Content="Сохранить читателя" Classes="primary" Click="SaveClick" />
						<Button Content="Отмена" Classes="outline" Click="CancelClick" />
					</StackPanel>
				</StackPanel>
			</Border>
		</StackPanel>
	</ScrollViewer>
</UserControl>

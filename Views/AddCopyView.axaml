<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ktpt.CourseOrder.Views.AddCopyView">

	<ScrollViewer>
		<StackPanel Spacing="20" MaxWidth="820" HorizontalAlignment="Stretch" Margin="0,0,0,20">
			<StackPanel Spacing="4">
				<TextBlock Classes="h1" Text="Приём книги в фонд" />
				<TextBlock Classes="muted" Text="Новые экземпляры сразу становятся доступны для выдачи" />
			</StackPanel>

			<Border Classes="card" Padding="28">
				<StackPanel Spacing="16">
					<StackPanel Spacing="6">
						<TextBlock Classes="label" Text="КНИГА *" />
						<ComboBox x:Name="BookBox" HorizontalAlignment="Stretch" PlaceholderText="Выберите книгу из каталога" />
					</StackPanel>

					<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
						<TextBlock Classes="label" Text="РАСПОЛОЖЕНИЕ (ПОЛКА) *" Margin="0,0,0,6" />
						<TextBlock Grid.Column="1" Classes="label" Text="КОЛИЧЕСТВО ЭКЗЕМПЛЯРОВ" Margin="12,0,0,6" />
						<TextBox Grid.Row="1" x:Name="ShelfBox" PlaceholderText="Например: A-1, B-3" />
						<NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="CountBox" Value="1" Minimum="1" Maximum="100"
						               Increment="1" FormatString="0" Margin="12,0,0,0" CornerRadius="10" />
					</Grid>

					<Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4" />

					<StackPanel Orientation="Horizontal" Spacing="10">
						<Button Content="Добавить на полку" Classes="primary" Click="SaveClick" />
						<Button Content="Отмена" Classes="outline" Click="CancelClick" />
					</StackPanel>
				</StackPanel>
			</Border>
		</StackPanel>
	</ScrollViewer>
</UserControl>
